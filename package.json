{
  "name": "@vantageos/mcp-agent-composer",
  "version": "1.0.0",
  "description": "MCP server that composes an AI agent by mixing Role + Persona + Framework + Skills as a structured primitive. Bilingual FR+EN. stdio, no API key.",
  "description_fr": "Serveur MCP qui compose un agent IA en mixant Rôle + Persona + Framework + Skills comme primitive structurée. Bilingue FR+EN. stdio, pas de clé API.",
  "keywords": [
    "mcp",
    "claude-code",
    "agent-composer",
    "agent",
    "persona",
    "framework",
    "composition",
    "vantage",
    "elpi"
  ],
  "license": "MIT",
  "author": "ElPi Corp / Laurent Perello",
  "homepage": "https://github.com/elpiarthera/vantage-agent-composer-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elpiarthera/vantage-agent-composer-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/elpiarthera/vantage-agent-composer-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vantage-agent-composer-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.fr.md",
    "LICENSE",
    "mcp.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "evals": "node scripts/run-evals.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
